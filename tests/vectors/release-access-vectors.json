      "version": "99.0.0",
      "covered": true
    },
    {
      "description": "a version within the covered major",
      "updatesUntil": null,
      "upToMajor": 2,
      "upToVersion": null,
      "now": "2027-01-01T00:00:00Z",
      "version": "2.9.9",
      "covered": true
    },
    {
      "description": "an older major",
      "updatesUntil": null,
